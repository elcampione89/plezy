# The panel's web address (no slash at the end). Download links in the update pop-up use it.
PUBLIC_URL=https://plezy.daemonhub.tech

# Your password for the panel. Make it long.
ADMIN_PASSWORD=

# Shared key so GitHub can hand new builds to the panel.
# Put the same value in GitHub: your plezy fork > Settings > Secrets and variables > Actions > PANEL_CI_TOKEN
CI_TOKEN=

# Keeps you signed in across restarts. Any long random text (e.g. run: openssl rand -hex 32).
SECRET_KEY=
